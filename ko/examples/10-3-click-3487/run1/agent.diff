+@pytest.mark.parametrize("empty", [b"", bytearray()])
+def test_echo_empty_bytes_with_newline(empty):
+    f = BytesIO()
+    click.echo(empty, f, nl=True)
+    assert f.getvalue() == b"\n"
+
+    f = BytesIO()
+    click.echo(empty, f, nl=False)
+    assert f.getvalue() == b""
+
+
+def test_echo_bytearray_not_mutated():
+    data = bytearray(b"abc")
+    click.echo(data, BytesIO())
+    assert data == bytearray(b"abc")
+
+
