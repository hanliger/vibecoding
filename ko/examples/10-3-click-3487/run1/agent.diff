+++ b/src/click/utils.py
@@ -294,11 +294,13 @@ def echo(
         out = message
 
     if nl:
-        out = out or ""
+        if out is None:
+            out = ""
         if isinstance(out, str):
-            out += "\n"
+            out = out + "\n"
         else:
-            out += b"\n"
+            # Not ``+=``: that would mutate a caller's bytearray in place.
